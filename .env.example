# من لوحة مطوري X: https://developer.x.com/en/portal/dashboard
# Keys and tokens → API Key + API Key Secret (Consumer Key/Secret)
# User authentication settings → Callback URI / Redirect URL:
#   http://localhost:3000/api/auth/x/callback
#   https://hudu-tz2i.onrender.com/api/auth/x/callback
# App permissions: Read and write

X_API_KEY=
X_API_SECRET=

# (اختياري) OAuth 2.0 — لا يُستخدم إذا وُجدت X_API_KEY/SECRET
X_CLIENT_ID=
X_CLIENT_SECRET=

# يُستخدم لتشفير الجلسات (أي نص عشوائي طويل)
SESSION_SECRET=change-me-to-a-long-random-string

# (اختياري) Postgres — بدونها يُستخدم تخزين ملفات محلي
# DATABASE_URL=
